# Настройки, которые отличаются от значений ESP-IDF по умолчанию. Первая
# сборка создаёт по этому файлу sdkconfig; настройки меняют здесь, а не
# в sdkconfig.

# Определение корпуса чипа (src/tools/esp_esp32.cpp) знает только ESP32.
CONFIG_IDF_TARGET="esp32"

# Цветной журнал в мониторе (с ESP-IDF 6.0 по умолчанию выключен).
CONFIG_LOG_COLORS=y

# Объём флеш-памяти — 4 МБ, как у платы TTGO VGA32 v1.4 (чип
# ESP32-PICO-D4 со встроенной флеш-памятью); по умолчанию ESP-IDF выбирает
# 2 МБ. Настоящий объём выводится в сведениях о плате при запуске.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Дальше — настройки, которых требует код, полученный из FabGL (src/gfx,
# src/vga, src/ps2, src/sound). Они взяты из файла idf/sdkconfig.fabgl
# порта FabGL на ESP-IDF 6.

# Порты PS/2 обслуживает сопроцессор ULP в режиме FSM. Его программа и
# переменные занимают 2112 байт медленной памяти RTC, а ESP-IDF размещает
# свои данные сразу за зарезервированной областью, поэтому резерв — 4096
# байт. Без этих трёх настроек FabGL не компилируется.
CONFIG_ULP_COPROC_ENABLED=y
CONFIG_ULP_COPROC_TYPE_FSM=y
CONFIG_ULP_COPROC_RESERVE_MEM=4096

# FabGL отлажена на частоте процессора 240 МГц и с тактом FreeRTOS 1 мс,
# как в ядре Arduino; по умолчанию ESP-IDF выбирает 160 МГц и 10 мс.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Обработчики прерываний видеовывода работают и при отключённом кэше
# флеш-памяти (например, пока идёт запись во флеш-память) и вызывают
# функции FreeRTOS, поэтому те должны находиться в IRAM.
CONFIG_FREERTOS_IN_IRAM=y

# FabGL назначает свои прерывания нужному ядру через задачи IPC; со стеком
# по умолчанию, 1024 байта, у этих задач остаётся меньше 400 байт стека.
CONFIG_ESP_IPC_TASK_STACK_SIZE=2048

# Код Wi-Fi и PHY не размещается в IRAM (по умолчанию ESP-IDF помещает туда
# около 25 КБ). Свободная IRAM становится кучей, из которой FabGL выделяет
# память под 32-разрядные данные (MALLOC_CAP_32BIT).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
